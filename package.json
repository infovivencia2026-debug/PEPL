{
  "name": "pepl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:setup": "node --experimental-strip-types scripts/bootstrap.ts",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "gate:rls": "node --experimental-strip-types scripts/gate-rls.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run db:setup && npm run migrate && npm run gate:rls && npm run gate:config && npm run gate:permissions && npm test && npm run gate:launch",
    "gate:config": "node --experimental-strip-types scripts/gate-config.ts",
    "db:reset": "node --experimental-strip-types scripts/reset-db.ts",
    "gate:launch": "node --experimental-strip-types scripts/gate-launch.ts",
    "api": "node --experimental-strip-types src/http/server.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "openapi": "node --experimental-strip-types scripts/openapi.ts",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "tsc --noEmit && tsc -p web/tsconfig.json && vite build",
    "start": "node --experimental-strip-types src/http/server.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "job": "node --experimental-strip-types scripts/run-job.ts",
    "shoot": "node --experimental-strip-types scripts/shoot.ts",
    "check:responsive": "node --experimental-strip-types scripts/responsive-check.ts",
    "scheduler": "node --experimental-strip-types src/jobs/scheduler.ts",
    "gate:permissions": "node --experimental-strip-types scripts/gate-permissions.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "seed:statutory": "node --experimental-strip-types scripts/seed-statutory.ts",
    "drill:restore": "node --experimental-strip-types scripts/restore-drill.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dotenv": "^16.4.5",
    "imapflow": "^2.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.43.0",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
