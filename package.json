{
  "name": "pepl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:setup": "node --experimental-strip-types scripts/bootstrap.ts",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "gate:rls": "node --experimental-strip-types scripts/gate-rls.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run db:setup && npm run migrate && npm run gate:rls && npm run gate:config && npm test",
    "gate:config": "node --experimental-strip-types scripts/gate-config.ts",
    "db:reset": "node --experimental-strip-types scripts/reset-db.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}