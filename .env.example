PGHOST=localhost
PGPORT=5432
SUPER_USER=postgres
SUPER_PASSWORD=postgres
PEPL_DB=pepl_dev
OWNER_USER=pepl_owner
OWNER_PASSWORD=pepl_owner_dev
APP_USER=pepl_app
APP_PASSWORD=pepl_app_dev

# Encrypts stored mailbox passwords (AES-256-GCM, per tenant).
# Outbound mail will not send without it. Rotating it strands existing
# mailbox credentials, so treat it like a database password.
PEPL_MAIL_KEY=change-me-in-every-environment

# Bearer token a Prometheus scraper presents to GET /metrics. Leave unset to
# allow loopback only (a sidecar). A stranger gets 404, not 401.
# PEPL_METRICS_TOKEN=

# S3-compatible object storage for NEW document bytes. All four or none.
# PEPL_OBJECT_STORE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# PEPL_OBJECT_STORE_BUCKET=pepl-documents
# PEPL_OBJECT_STORE_REGION=ap-south-1
# PEPL_OBJECT_STORE_ACCESS_KEY=
# PEPL_OBJECT_STORE_SECRET_KEY=

# Web Push identity (VAPID). `npm run job push.keygen` prints a fresh pair.
# All three or none. The private key lets anyone push as PEPL.
# PEPL_VAPID_PUBLIC_KEY=
# PEPL_VAPID_PRIVATE_KEY=
# PEPL_VAPID_SUBJECT=mailto:ops@yourcompany.example

# The address employees open. Builds password-reset links.
# PEPL_PUBLIC_URL=https://hr.yourcompany.example

# Share rate-limit counters across API instances (default: memory, one instance).
# PEPL_RATE_LIMIT_STORE=postgres

# ── The supplier on a GST tax invoice ────────────────────────────────────
# These describe YOUR company, not a tenant, so they belong to the deployment.
# Without PEPL_GSTIN an invoice still renders but marks itself "not a tax
# invoice", so a dev box can never emit something a customer might try to file.
# PEPL_STATE_CODE decides CGST+SGST (same state as the customer) against IGST.
PEPL_LEGAL_NAME=
PEPL_ADDRESS=
PEPL_GSTIN=
PEPL_STATE_CODE=
PEPL_BILLING_EMAIL=

# Where customers send the money. The invoice tells them to pay by transfer,
# so without these it names no account and their finance team cannot act on it.
PEPL_BANK_NAME=
PEPL_BANK_ACCOUNT_NAME=
PEPL_BANK_ACCOUNT_NUMBER=
PEPL_BANK_IFSC=

# ── the ones that were used but undocumented ────────────────────────────────
# Which port the API listens on. 3100 in development; the VPS uses 4010.
PORT=3100
# 'production' turns on the checks that matter: preflight refuses development
# passwords, HSTS is sent, cookies are Secure, and loopback is no longer an
# acceptable webhook target.
NODE_ENV=development
# Salt for the anonymised salary benchmark aggregates. A SECRET: with it, the
# published bands can be walked back to individual companies. Generate once per
# deployment (`openssl rand -hex 32`) and never rotate casually — changing it
# re-buckets every historical sample.
PEPL_BENCHMARK_SALT=dev-benchmark-salt-not-for-production
