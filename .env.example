PGHOST=localhost
PGPORT=5432
SUPER_USER=postgres
SUPER_PASSWORD=postgres
PEPL_DB=pepl_dev
OWNER_USER=pepl_owner
OWNER_PASSWORD=pepl_owner_dev
APP_USER=pepl_app
APP_PASSWORD=pepl_app_dev

# Encrypts stored mailbox passwords (AES-256-GCM, per tenant).
# Outbound mail will not send without it. Rotating it strands existing
# mailbox credentials, so treat it like a database password.
PEPL_MAIL_KEY=change-me-in-every-environment

# Bearer token a Prometheus scraper presents to GET /metrics. Leave unset to
# allow loopback only (a sidecar). A stranger gets 404, not 401.
# PEPL_METRICS_TOKEN=

# S3-compatible object storage for NEW document bytes. All four or none.
# PEPL_OBJECT_STORE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# PEPL_OBJECT_STORE_BUCKET=pepl-documents
# PEPL_OBJECT_STORE_REGION=ap-south-1
# PEPL_OBJECT_STORE_ACCESS_KEY=
# PEPL_OBJECT_STORE_SECRET_KEY=

# Web Push identity (VAPID). `npm run job push.keygen` prints a fresh pair.
# All three or none. The private key lets anyone push as PEPL.
# PEPL_VAPID_PUBLIC_KEY=
# PEPL_VAPID_PRIVATE_KEY=
# PEPL_VAPID_SUBJECT=mailto:ops@yourcompany.example
